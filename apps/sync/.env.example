# Copy to apps/sync/.env. Local values match `pnpm db:status`.
PORT=1234
# Direct Postgres connection (bypasses RLS). Local: the DB_URL from db:status.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Must match the issuer in Supabase access tokens (the API URL, with 127.0.0.1 locally).
SUPABASE_URL=http://127.0.0.1:55321
# Shared with apps/web (SYNC_SECRET) for the refresh endpoint.
SYNC_SECRET=dev-sync-secret
