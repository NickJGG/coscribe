# Copy to .env.local. For local development, take the values from `pnpm db:status`
# (API URL and Publishable key). For production, use the hosted project's values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# apps/sync: the browser connects over WebSocket; the server derives the HTTP URL from it.
NEXT_PUBLIC_SYNC_URL=ws://localhost:1234
# Server-only. Must match SYNC_SECRET in apps/sync/.env.
SYNC_SECRET=dev-sync-secret
